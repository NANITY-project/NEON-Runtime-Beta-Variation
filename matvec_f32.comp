#version 450
// =============================================================================
// matvec_f32.comp v2 — subgroup-per-row F32 matvec (llama.cpp/ggml-vulkan and
// rocBLAS GEMV kernels use this exact shape: one subgroup/wavefront owns one
// output row end-to-end, reduces with a subgroup-intrinsic add, and never
// touches shared memory or a barrier).
//
// v1 (kept as matvec_f32_scalar.comp, still shipped as the fallback pipeline
// for cols not divisible by 4) put ALL 256 invocations of a workgroup on
// ONE row and combined them with a shared-memory tree reduction: 8 barrier()
// round-trips per row, one row finished at a time per workgroup.
//
// v2 instead partitions each workgroup into gl_NumSubgroups independent
// subgroups (256/subgroupSize -- e.g. 8 groups of 32 lanes on most desktop
// GPUs, 4 groups of 64 on AMD wave64, 32 groups of 8 on lavapipe) and gives
// EACH subgroup its own row. Every lane's cross-lane reduction happens via
// subgroupAdd(), which lowers to a handful of hardware shuffle/butterfly
// instructions with no shared memory and no barrier() at all -- and
// gl_NumSubgroups rows finish per workgroup dispatch instead of 1. This is
// the same "N rows per workgroup, wavefront-per-row" trick rocBLAS's GEMV
// kernels and llama.cpp's mul_mat_vec shaders use for the same reason: a
// single row's dot product rarely has enough work to keep the reduction
// tree's later stages (stride 128, 64, 32...) busy, so folding the
// cross-lane part into subgroup intrinsics and using the freed-up
// parallelism to cover MORE rows per dispatch is a straight win.
//
// Loads are vec4-vectorized (4 floats/lane/iteration instead of 1) to cut
// the instruction count and better saturate memory bandwidth -- safe here
// because the host only selects this pipeline when cols % 4 == 0 (see
// rawllm_vulkan.hpp's pipeline-selection comment); otherwise it dispatches
// matvec_f32_scalar.comp instead.
//
// Contract (must match VulkanMatvecBackend::matvec_f32() / pipeline setup):
//   binding 0: W  — row-major float matrix reinterpreted as vec4[rows*cols/4]
//   binding 1: x  — shared activation vector, reinterpreted as vec4[cols/4]
//   binding 2: y  — output vector, rows floats (writeonly)
//   push constants: { uint cols; uint rows; }
//   dispatch: vkCmdDispatch(ceil(rows / rows_per_workgroup), 1, 1), where
//             rows_per_workgroup = local_size_x / subgroupSize is computed
//             host-side from VkPhysicalDeviceSubgroupProperties (queried
//             once at device pick time) -- gl_NumSubgroups at shader
//             execution time is the same value, so row indexing agrees.
// =============================================================================

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

// EXPERIMENTAL (untested on real hardware — compile/spirv-val only):
// `restrict` on all three bindings tells the compiler W/X/Y never alias
// each other or themselves, which is always true given how the host
// constructs these descriptors (W is a resident weight tensor, X/Y are
// per-call scratch buffers, Y is writeonly anyway) — this can unlock
// more aggressive load scheduling/reordering on some drivers (Mesa/RADV,
// NVIDIA) but is a no-op on others; safe either way since the aliasing
// assumption genuinely holds.
layout(std430, binding = 0) readonly restrict buffer WBuf { vec4 Wv[]; };
layout(std430, binding = 1) readonly restrict buffer XBuf { vec4 Xv[]; };
layout(std430, binding = 2) writeonly restrict buffer YBuf { float Y[]; };

layout(push_constant) uniform Params {
    uint cols;
    uint rows;
} params;

void main() {
    uint rows_per_wg = gl_NumSubgroups;
    uint row = gl_WorkGroupID.x * rows_per_wg + gl_SubgroupID;
    if (row >= params.rows) return;

    uint vec_cols = params.cols >> 2u; // cols/4, host guarantees cols % 4 == 0
    uint row_off = row * vec_cols;
    uint lane = gl_SubgroupInvocationID;
    uint sg_size = gl_SubgroupSize;

    // EXPERIMENTAL: 2-wide unrolled loop with two independent accumulators.
    // Same total work as before, but breaks the single acc4 += ... chain's
    // serial dependency into two independent chains that can execute back
    // to back / overlap their load latency — a standard latency-hiding
    // trick for a loop this simple, where the compiler may not always
    // auto-unroll+split across driver/compiler versions. sg_size2 strides
    // by 2*sg_size per iteration; the remainder loop below covers vec_cols
    // not evenly divisible by (2*sg_size), which is common (e.g. sg_size=32,
    // vec_cols=1024/4=256 -> divides evenly, but sg_size=64 or odd hidden
    // dims may not).
    uint stride2 = sg_size * 2u;
    uint j = lane;
    vec4 acc4a = vec4(0.0);
    vec4 acc4b = vec4(0.0);
    for (; j + sg_size < vec_cols; j += stride2) {
        acc4a += Wv[row_off + j] * Xv[j];
        acc4b += Wv[row_off + j + sg_size] * Xv[j + sg_size];
    }
    vec4 acc4 = acc4a + acc4b;
    for (; j < vec_cols; j += sg_size) {
        acc4 += Wv[row_off + j] * Xv[j];
    }
    float acc = subgroupAdd(acc4.x + acc4.y + acc4.z + acc4.w);

    if (lane == 0u) {
        Y[row] = acc;
    }
}
