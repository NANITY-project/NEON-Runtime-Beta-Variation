#version 450
// =============================================================================
// matvec_f32.comp — F32 matvec compute shader for rawllm_vulkan.hpp's
// experimental VulkanMatvecBackend.
//
// This was the missing half of the Vulkan backend: rawllm_vulkan.hpp's
// VulkanMatvecBackend constructor loads "shaders/matvec_f32.spv" and expects
// the build to have run `glslc`/`glslangValidator -V` on this file first, but
// this source didn't exist yet — the header could compile, but
// VulkanMatvecBackend() would throw at construction (read_spirv() failing to
// open a file that was never produced). This file, plus the build-step note
// in rawllm_vulkan.hpp's own header comment, closes that gap.
//
// Contract (must match VulkanMatvecBackend::matvec() / create_descriptor_and_
// pipeline() exactly):
//   binding 0: W  — row-major float matrix, rows*cols floats (readonly)
//   binding 1: x  — shared activation vector, cols floats     (readonly)
//   binding 2: y  — output vector, rows floats                (writeonly)
//   push constants: { uint cols; uint rows; }
//   dispatch: vkCmdDispatch(rows, 1, 1) — one workgroup per output row,
//             i.e. gl_WorkGroupID.x IS the row index, not just an index hint.
//
// Per workgroup: LOCAL_SIZE invocations each stride across that row's `cols`
// elements accumulating a partial dot product, then a standard shared-memory
// tree reduction combines the LOCAL_SIZE partials into the row's final
// scalar, which invocation 0 writes to y[row]. This mirrors the same
// "quantize once, dot per output row" shape as the CPU path in
// rawllm_forward.hpp's proj_all_positions() — just parallelized across GPU
// invocations instead of CPU threads, and over plain F32 (no fused int8
// path on the GPU side yet — see this shader's header-file counterpart for
// why that's a documented follow-up, not done here).
// =============================================================================

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer WBuf { float W[]; };
layout(std430, binding = 1) readonly buffer XBuf { float X[]; };
layout(std430, binding = 2) writeonly buffer YBuf { float Y[]; };

layout(push_constant) uniform Params {
    uint cols;
    uint rows;
} params;

shared float partial[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= params.rows) return;

    uint tid = gl_LocalInvocationID.x;
    uint row_off = row * params.cols;

    float acc = 0.0;
    for (uint j = tid; j < params.cols; j += gl_WorkGroupSize.x) {
        acc += W[row_off + j] * X[j];
    }
    partial[tid] = acc;
    barrier();

    // Standard power-of-two tree reduction (workgroup size is fixed at 256
    // above, so no odd-count tail to handle).
    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial[tid] += partial[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        Y[row] = partial[0];
    }
}
