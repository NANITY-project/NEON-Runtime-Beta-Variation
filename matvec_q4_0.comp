#version 450
// =============================================================================
// matvec_q4_0.comp — fused Q4_0(weight) x Q8_0(activation) matvec, the GPU
// counterpart of rawllm_simd_dispatch.hpp's simd::dot_q4_0_q8_0(). This is
// the actual point of a "quantized GPU kernel" (per rawllm_vulkan.hpp's old
// header comment listing this as a documented follow-up): the multi-hundred-
// MB Q4_0 weight matrix is uploaded to the GPU ONCE, still packed, and never
// dequantized to F32 anywhere — matching the on-disk block layout exactly
// so no CPU-side pre-pass is needed:
//
//   Q4_0 weight block, 18 bytes: [ 2 bytes fp16 scale d ][ 16 bytes packed
//   nibbles ] — 32 unsigned 4-bit values per block, byte i holds value i
//   in bits [0:3] (paired with value i+16 in bits [4:7]), values are
//   (nibble - 8) in the true weight domain.
//
//   Q8_0 activation block, per-block layout on the HOST side is split into
//   three parallel float/int arrays (X_D, X_SUM, X_Q) rather than the
//   on-disk 34-byte block, because the activation vector is re-quantized
//   fresh every token and is tiny (cols floats, not rows*cols) — no reason
//   to pay a repack-to-disk-layout cost for something this small. X_SUM is
//   the per-block sum of the 32 quantized int8 activations, precomputed
//   host-side once (see rawllm_simd_dispatch.hpp's dot_q4_0_q8_0 comment on
//   why: it's identical for every one of the thousands of rows that share
//   this activation block, so hoisting it out of the per-row loop is a
//   real CPU-side win already applied there, and the same hoist applies
//   here) and used for the "-8 per nibble" bias correction:
//     isum_true = isum_uncentered - 8 * x_sum[block]
//   (because sum_j (nibble_j - 8) * xq_j = sum_j nibble_j*xq_j - 8*sum_j xq_j,
//   and x_sum[block] IS sum_j xq_j).
//
// Reduction shape: identical subgroup-per-row / subgroupAdd pattern as
// matvec_f32.comp — see that file's header for the rationale. Blocks (not
// individual weight bytes) are strided across the subgroup's lanes; each
// lane fully resolves its own blocks' 32-wide nibble unpack + int8 dot
// before subgroupAdd combines the per-lane partial sums. That's a coarser
// partition than the CPU path's "1 thread iterates every block of a row"
// but the right one at this granularity: splitting a single 18-byte block
// across multiple lanes would mean sub-block synchronization for a payload
// (16 bytes) smaller than one cache line already.
//
// Byte-addressing note: the weight buffer is declared as a uint[] (4-byte
// words), not uint8_t[], to stay portable without VK_KHR_8bit_storage or
// VK_EXT_shader_8bit_storage (neither is assumed present). readByte()
// extracts one byte at an arbitrary byte offset via a shift+mask, which is
// what lets an 18-byte, non-4-byte-aligned block stride work at all;
// readHalf() composes two such bytes and reuses unpackHalf2x16 (a core
// GLSL 4.5 builtin) to get the fp16->f32 conversion for free, matching
// rawllm_common.hpp's f16_to_f32() bit-for-bit (both are IEEE-754 binary16
// decodes; there is no rounding-mode ambiguity here since neither side
// does arithmetic in half precision, just conversion).
//
// Contract:
//   binding 0: W      — raw Q4_0-block bytes, rows*(cols/32)*18 bytes, as uint[]
//   binding 1: X_Q     — int8 quantized activations, cols values. Widened to
//                        int (portable build) or kept as int8_t (INT8_STORAGE
//                        build, see #ifdef below) — rawllm_vulkan.hpp's
//                        queue_matvec_quantized() picks upload size/format to match.
//   binding 2: X_D     — per-block activation scale, cols/32 floats
//   binding 3: X_SUM   — per-block sum of X_Q, cols/32 ints
//   binding 4: y       — output vector, rows floats (writeonly)
//   push constants: { uint cols; uint rows; }
//   dispatch: same rows_per_workgroup scheme as matvec_f32.comp.
// =============================================================================

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#ifdef INT8_STORAGE
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#endif

layout(local_size_x = 256) in;

// EXPERIMENTAL: restrict — see matvec_f32.comp's header for the rationale.
layout(std430, binding = 0) readonly restrict buffer WBuf   { uint W[]; };
#ifdef INT8_STORAGE
// INT8_STORAGE build (compiled with -DINT8_STORAGE=1 into
// matvec_q4_0_int8.spv — see rawllm_vulkan.hpp's create_pipelines()):
// X_Q holds the caller's int8 activations verbatim, one byte per value,
// instead of widened to a 4-byte int. Requires VK_KHR_8bit_storage +
// VK_KHR_shader_float16_int8 (storageBuffer8BitAccess + shaderInt8) —
// see rawllm_vulkan.hpp's create_device_and_queue() for the capability
// check and int8_activation_supported()'s comment for the fallback
// this is an alternative to. Every read site below wraps X_Q[...] in
// int(...) either way, so this branch is the ONLY place the storage
// type differs; the arithmetic is identical to the portable build.
//
// NOT YET VALIDATED: written to compile against the same GLSL 4.5 base
// this file's portable build already passes glslangValidator+spirv-val
// with (see matmul_tiled_q4_0.comp's HAS_INT8_DOT comment for the
// broader context — this repo's available glslang couldn't even parse
// GL_EXT_shader_integer_dot_product, a similarly-recent extension; the
// same toolchain gap may apply here and hasn't been checked this pass).
// Treat as compiles-and-should-be-right, not validated, same status
// matmul_tiled_q4_0.comp/matmul_tiled_q8_0.comp shipped with before
// their first real hardware run.
layout(std430, binding = 1) readonly restrict buffer XQBuf  { int8_t X_Q[]; };
#else
layout(std430, binding = 1) readonly restrict buffer XQBuf  { int X_Q[]; };
#endif
layout(std430, binding = 2) readonly restrict buffer XDBuf  { float X_D[]; };
layout(std430, binding = 3) readonly restrict buffer XSBuf  { int X_SUM[]; };
layout(std430, binding = 4) writeonly restrict buffer YBuf  { float Y[]; };

layout(push_constant) uniform Params {
    uint cols;
    uint rows;
} params;

const uint BLOCK_BYTES = 18u; // 2 (fp16 scale) + 16 (32 packed nibbles)

uint readByte(uint byteIdx) {
    uint word = W[byteIdx >> 2u];
    uint shift = (byteIdx & 3u) * 8u;
    return (word >> shift) & 0xFFu;
}

float readHalf(uint byteIdx) {
    uint lo = readByte(byteIdx);
    uint hi = readByte(byteIdx + 1u);
    return unpackHalf2x16(lo | (hi << 8u)).x;
}

// EXPERIMENTAL: composes an arbitrarily byte-aligned little-endian 4-byte
// word from at most 2 buffer loads (vs. 4 separate readByte() calls, each
// itself a load+shift+mask). Used below to replace the Q4_0 nibble-unpack
// inner loop's 16 individual readByte() calls (up to 16 loads if the
// compiler doesn't CSE across the unrolled iterations) with 4 readWord4()
// calls (at most 8 loads) — same math, fewer memory instructions. Whether
// this is a net win depends on the driver's own load-coalescing/CSE, which
// is exactly why this is filed as "unsure" rather than a confirmed win.
uint readWord4(uint byteIdx) {
    uint w0 = W[byteIdx >> 2u];
    uint shift = (byteIdx & 3u) * 8u;
    if (shift == 0u) return w0;
    uint w1 = W[(byteIdx >> 2u) + 1u];
    return (w0 >> shift) | (w1 << (32u - shift));
}

void main() {
    uint rows_per_wg = gl_NumSubgroups;
    uint row = gl_WorkGroupID.x * rows_per_wg + gl_SubgroupID;
    if (row >= params.rows) return;

    uint nb = params.cols / 32u;
    uint row_byte_off = row * nb * BLOCK_BYTES;
    uint lane = gl_SubgroupInvocationID;
    uint sg_size = gl_SubgroupSize;

    float acc = 0.0;
    for (uint b = lane; b < nb; b += sg_size) {
        uint blk = row_byte_off + b * BLOCK_BYTES;
        float wd = readHalf(blk);
        uint qs_off = blk + 2u;
        uint act_off = b * 32u;

        // EXPERIMENTAL: 4-at-a-time via readWord4() — see that function's
        // header comment. Functionally identical to the old per-byte loop
        // (same nibble extraction, same j indexing), just fewer loads.
        int isum = 0;
        for (uint j4 = 0u; j4 < 16u; j4 += 4u) {
            uint w = readWord4(qs_off + j4);
            for (uint k = 0u; k < 4u; ++k) {
                uint packed = (w >> (k * 8u)) & 0xFFu;
                uint j = j4 + k;
                int lo = int(packed & 0xFu);
                int hi = int(packed >> 4u);
                isum += lo * int(X_Q[act_off + j]) + hi * int(X_Q[act_off + j + 16u]);
            }
        }
        isum -= 8 * X_SUM[b];

        acc += wd * X_D[b] * float(isum);
    }
    acc = subgroupAdd(acc);

    if (lane == 0u) {
        Y[row] = acc;
    }
}
